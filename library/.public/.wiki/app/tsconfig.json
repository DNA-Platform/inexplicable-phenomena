{
  "compilerOptions": {
    "target": "ES2020",
    "jsx": "react-jsx",
    "module": "esnext",
    "lib": ["dom", "dom.iterable", "esnext"],
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "experimentalDecorators": true,
    "paths": {
      "@dna-platform/lib": ["../../package/src/index.ts"],
      "@dna-platform/chemistry": ["../../../chemistry/package/src/index.ts"],
      "@/*": ["../../package/src/*"]
    }
  },
  "include": ["src", "vite.config.ts"]
}

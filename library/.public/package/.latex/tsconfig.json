{
  "compilerOptions": {
    "target": "ES2020",
    "jsx": "react-jsx",
    "module": "esnext",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "experimentalDecorators": true,
    "forceConsistentCasingInFileNames": true,
    "types": [
      "vitest/globals"
    ],
    "paths": {
      "@/*": [
        "../src/*"
      ],
      "@dna-platform/public": [
        "../src/index.ts"
      ],
      "@dna-platform/public/encyclopedia": [
        "../src/encyclopedia/index.ts"
      ],
      "@dna-platform/public/library": [
        "../src/library.ts"
      ],
      "@dna-platform/public/article": [
        "../src/article/index.ts"
      ]
    }
  },
  "include": [
    "*.ts",
    "*.tsx",
    ".*.ts",
    ".*.tsx",
    ".public/main.tsx",
    "aaronson/**/*.tsx",
    "aaronson/**/.*.tsx",
    ".public/aaronson/**/*.tsx",
    ".public/aaronson/**/.*.tsx"
  ]
}

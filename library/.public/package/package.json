{
  "name": "@dna-platform/public",
  "version": "0.0.3",
  "description": "The canonical code library for creating libraries â€” the base classes a library instantiates against, built on @dna-platform/chemistry",
  "license": "MIT",
  "author": "Doug Rubino",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DNA-Platform/inexplicable-phenomena.git",
    "directory": "library/.public/package"
  },
  "main": "dist/lib.cjs",
  "module": "dist/lib.js",
  "types": "dist/lib.d.ts",
  "exports": {
    ".": {
      "types": "./dist/lib.d.ts",
      "import": "./dist/lib.js",
      "require": "./dist/lib.cjs"
    },
    "./library": {
      "types": "./dist/library.d.ts",
      "import": "./dist/library.js",
      "require": "./dist/library.cjs"
    },
    "./article": {
      "types": "./dist/article.d.ts",
      "import": "./dist/article.js",
      "require": "./dist/article.cjs"
    },
    "./markdown": {
      "types": "./dist/markdown.d.ts",
      "import": "./dist/markdown.js",
      "require": "./dist/markdown.cjs"
    },
    "./application": {
      "types": "./dist/application.d.ts",
      "import": "./dist/application.js",
      "require": "./dist/application.cjs"
    },
    "./encyclopedia": {
      "types": "./dist/encyclopedia.d.ts",
      "import": "./dist/encyclopedia.js",
      "require": "./dist/encyclopedia.cjs"
    },
    "./utilities": {
      "types": "./dist/utilities.d.ts",
      "import": "./dist/utilities.js",
      "require": "./dist/utilities.cjs"
    }
  },
  "files": [
    "dist",
    ".binding"
  ],
  "scripts": {
    "prebuild": "rimraf dist/chunks && tsx register.ts",
    "build": "rollup -c",
    "push": "npm version patch --no-git-tag-version && npm publish",
    "prepublishOnly": "npm run test:gate",
    "build:quick": "rollup -c --environment QUICK",
    "build:clean": "rimraf dist .rollup.cache && rollup -c",
    "typecheck": "tsc --noEmit -p src/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "wiki": "npm --prefix .wiki/.public/.binding run build",
    "test:gate": "tsc --noEmit -p src/tsconfig.json && npm run build && vitest run",
    "verify:latex": "node .latex/.public/.binding/design/verify-latex.mjs",
    "verify:wiki": "node .wiki/.public/.binding/design/verify-wiki.mjs",
    "latex": "npm --prefix .latex/.public/.binding run build",
    "sync": "npm --prefix .latex/.public/.binding run sync && npm --prefix .wiki/.public/.binding run sync"
  },
  "dependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "katex": "^0.18.1",
    "latex.css": "^1.14.0",
    "marked": "^18.0.7"
  },
  "peerDependencies": {
    "react-router-dom": ">=7.0.0",
    "styled-components": "^6.1.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "@dna-platform/chemistry": "^0.1.2"
  },
  "devDependencies": {
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "rimraf": "^6.0.1",
    "rollup": "^4.50.2",
    "rollup-plugin-dts": "^6.2.3",
    "styled-components": "^6.1.0",
    "tslib": "^2.8.1",
    "typescript": "^5.9.2",
    "vitest": "^4.0.6",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "@dna-platform/chemistry": "*",
    "@types/katex": "^0.16.8"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com"
  }
}

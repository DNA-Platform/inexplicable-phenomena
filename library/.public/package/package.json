{
  "name": "@dna-platform/public",
  "version": "0.0.1",
  "description": "The canonical code library for creating libraries \u00e2\u20ac\u201d the base classes a library instantiates against, built on @dna-platform/chemistry",
  "license": "MIT",
  "author": "Doug Rubino",
  "repository": {
    "type": "git",
    "url": "https://github.com/DNA-Platform/inexplicable-phenomena.git",
    "directory": "library/.public/package"
  },
  "main": "dist/lib.cjs",
  "module": "dist/lib.js",
  "types": "dist/lib.d.ts",
  "exports": {
    ".": {
      "types": "./dist/lib.d.ts",
      "import": "./dist/lib.js",
      "require": "./dist/lib.cjs"
    },
    "./library": {
      "types": "./dist/library.d.ts",
      "import": "./dist/library.js",
      "require": "./dist/library.cjs"
    },
    "./article": {
      "types": "./dist/article.d.ts",
      "import": "./dist/article.js",
      "require": "./dist/article.cjs"
    },
    "./markdown": {
      "types": "./dist/markdown.d.ts",
      "import": "./dist/markdown.js",
      "require": "./dist/markdown.cjs"
    },
    "./encyclopedia": {
      "types": "./dist/encyclopedia.d.ts",
      "import": "./dist/encyclopedia.js",
      "require": "./dist/encyclopedia.cjs"
    },
    "./utilities": {
      "types": "./dist/utilities.d.ts",
      "import": "./dist/utilities.js",
      "require": "./dist/utilities.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prebuild": "rimraf dist/chunks && tsx sync.ts && tsx register.ts",
    "sync": "tsx sync.ts",
    "sync:check": "tsx sync.ts --check",
    "build": "rollup -c",
    "build:clean": "rimraf dist .rollup.cache && rollup -c",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "tsx clean.ts",
    "wiki": "npm run build && vite .wiki/.public",
    "test:gate": "tsc --noEmit -p src/tsconfig.json && npm run build && vitest run"
  },
  "dependencies": {
    "@dna-platform/chemistry": "*",
    "@tailwindcss/typography": "^0.5.20",
    "@types/katex": "^0.16.8",
    "katex": "^0.18.1",
    "marked": "^18.0.7",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "peerDependencies": {
    "react-router-dom": ">=7.0.0",
    "styled-components": "^6.1.0"
  },
  "devDependencies": {
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "rimraf": "^6.0.1",
    "rollup": "^4.50.2",
    "rollup-plugin-dts": "^6.2.3",
    "styled-components": "^6.1.0",
    "tslib": "^2.8.1",
    "typescript": "^5.9.2",
    "vitest": "^4.0.6"
  }
}

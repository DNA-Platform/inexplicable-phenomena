{
  "name": "@dna-platform/lib",
  "version": "0.0.1",
  "description": "The canonical code library for creating libraries \u00e2\u20ac\u201d the base classes a library instantiates against, built on @dna-platform/chemistry",
  "license": "MIT",
  "author": "Doug Rubino",
  "repository": {
    "type": "git",
    "url": "https://github.com/DNA-Platform/inexplicable-phenomena.git",
    "directory": "library/.public/package"
  },
  "main": "dist/lib.cjs",
  "module": "dist/lib.js",
  "types": "dist/lib.d.ts",
  "exports": {
    ".": {
      "types": "./dist/lib.d.ts",
      "import": "./dist/lib.js",
      "require": "./dist/lib.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite app",
    "build": "rollup -c",
    "build:clean": "rimraf dist .rollup.cache && rollup -c",
    "typecheck": "tsc --noEmit",
    "test": "tsc --noEmit && tsc --noEmit -p src/tsconfig.json && node app/typecheck.mjs && vitest run",
    "typecheck:app": "node app/typecheck.mjs",
    "verify": "node app/verify-demo.mjs && node app/verify-book.mjs",
    "test:fast": "vitest run",
    "test:watch": "vitest",
    "test:all": "tsc --noEmit && vitest run && rollup -c --silent",
    "build:demo": "vite build app"
  },
  "dependencies": {
    "@dna-platform/chemistry": "*",
    "@types/katex": "^0.16.8",
    "katex": "^0.18.1",
    "marked": "^18.0.7",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "peerDependencies": {
    "react-router-dom": ">=7.0.0",
    "styled-components": "^6.1.0"
  },
  "devDependencies": {
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "rimraf": "^6.0.1",
    "rollup": "^4.50.2",
    "rollup-plugin-dts": "^6.2.3",
    "tslib": "^2.8.1",
    "typescript": "^5.9.2",
    "vitest": "^4.0.6",
    "styled-components": "^6.1.0"
  }
}
